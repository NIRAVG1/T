{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Temporal and Redis based hotel offer aggregation service",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:api": "node --env-file-if-exists=.env dist/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/temporal/worker.js",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch src/temporal/worker.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "RUN_COMPOSE_E2E=1 vitest run tests/integration/compose.e2e.test.ts"
  },
  "dependencies": {
    "@temporalio/activity": "1.11.8",
    "@temporalio/client": "1.11.8",
    "@temporalio/worker": "1.11.8",
    "@temporalio/workflow": "1.11.8",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
