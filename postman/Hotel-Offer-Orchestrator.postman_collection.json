{
  "info": {"name":"Hotel Offer Orchestrator","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"baseUrl","value":"http://localhost:3000"}],
  "item":[
    {"name":"Get all Delhi hotels","request":{"method":"GET","url":"{{baseUrl}}/api/hotels?city=delhi"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 200',()=>pm.response.to.have.status(200));","const hotels=pm.response.json();","pm.test('JSON array, deduplicated',()=>{pm.expect(hotels).to.be.an('array');pm.expect(new Set(hotels.map(h=>h.name.normalize('NFKC').trim().toLowerCase().replace(/\\s+/g,' '))).size).to.eql(hotels.length)});","pm.test('Cheapest Holtin from B',()=>{const h=hotels.find(x=>x.name.toLowerCase()==='holtin');pm.expect(h).to.include({price:5340,supplier:'Supplier B',commissionPct:20})});"]}}]},
    {"name":"Delhi price range 5000-7000","request":{"method":"GET","url":"{{baseUrl}}/api/hotels?city=delhi&minPrice=5000&maxPrice=7000"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 200',()=>pm.response.to.have.status(200));","const hotels=pm.response.json();","pm.test('All records within inclusive bounds',()=>hotels.forEach(h=>pm.expect(h.price).to.be.within(5000,7000)));","pm.test('Results ordered by price',()=>pm.expect(hotels.map(h=>h.price)).to.eql([...hotels.map(h=>h.price)].sort((a,b)=>a-b)));"]}}]},
    {"name":"Minimum only","request":{"method":"GET","url":"{{baseUrl}}/api/hotels?city=delhi&minPrice=6000"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 200',()=>pm.response.to.have.status(200));","pm.response.json().forEach(h=>pm.expect(h.price).to.be.at.least(6000));"]}}]},
    {"name":"Maximum only","request":{"method":"GET","url":"{{baseUrl}}/api/hotels?city=delhi&maxPrice=6000"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 200',()=>pm.response.to.have.status(200));","pm.response.json().forEach(h=>pm.expect(h.price).to.be.at.most(6000));"]}}]},
    {"name":"Unknown city","request":{"method":"GET","url":"{{baseUrl}}/api/hotels?city=mumbai"},"event":[{"listen":"test","script":{"exec":["pm.test('Empty result',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json()).to.eql([])})"]}}]},
    {"name":"Supplier A","request":{"method":"GET","url":"{{baseUrl}}/supplierA/hotels?city=delhi"},"event":[{"listen":"test","script":{"exec":["pm.test('Supplier response array',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json()).to.be.an('array')})"]}}]},
    {"name":"Supplier B","request":{"method":"GET","url":"{{baseUrl}}/supplierB/hotels?city=delhi"},"event":[{"listen":"test","script":{"exec":["pm.test('Supplier response array',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json()).to.be.an('array')})"]}}]},
    {"name":"Health check","request":{"method":"GET","url":"{{baseUrl}}/health"},"event":[{"listen":"test","script":{"exec":["pm.test('Health status response',()=>pm.expect(pm.response.code).to.be.oneOf([200,503]));","pm.expect(pm.response.json()).to.have.property('services');"]}}]},
    {"name":"Invalid city","request":{"method":"GET","url":"{{baseUrl}}/api/hotels?city=%20%20"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 400',()=>pm.response.to.have.status(400));"]}}]},
    {"name":"Invalid price range","request":{"method":"GET","url":"{{baseUrl}}/api/hotels?city=delhi&minPrice=7000&maxPrice=5000"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 400',()=>pm.response.to.have.status(400));"]}}]},
    {"name":"Non-numeric price","request":{"method":"GET","url":"{{baseUrl}}/api/hotels?city=delhi&minPrice=lots"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 400',()=>pm.response.to.have.status(400));"]}}]}
  ]
}
